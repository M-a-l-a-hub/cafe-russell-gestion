user www-data;
worker_processes 2;
pid /run/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 512;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    charset utf-8;

    server_tokens off;
    sendfile on;
    access_log /dev/stdout;

    # Même limite que l'application (1 Mo).
    client_max_body_size 1m;
    client_body_timeout 15s;
    client_header_timeout 15s;
    send_timeout 30s;

    # HSTS seulement si la requête est arrivée en HTTPS (TLS terminé par Render).
    map $http_x_forwarded_proto $hsts {
        default "";
        https   "max-age=31536000";
    }

    server {
        listen ${PORT} default_server;
        root /app/public;

        # Fichiers statiques : liste fermée de types, jamais de .php, .env,
        # .sql, etc. Les en-têtes de sécurité sont ajoutés ici ; pour tout le
        # reste (page HTML et API) c'est PHP qui les envoie.
        location ~* \.(css|js|json|svg|png|jpg|jpeg|webp|ico)$ {
            try_files $uri =404;
            expires -1;
            add_header X-Content-Type-Options "nosniff" always;
            add_header X-Frame-Options "DENY" always;
            add_header Referrer-Policy "no-referrer" always;
            add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
            add_header Strict-Transport-Security $hsts always;
        }

        # Tout le reste (/, /api/..., et même /app.html ou /x.php) passe par
        # public/index.php : page d'accueil, API ou erreur 404 JSON.
        location / {
            include fastcgi_params;
            fastcgi_param SCRIPT_FILENAME /app/public/index.php;
            fastcgi_param SCRIPT_NAME /index.php;
            fastcgi_pass 127.0.0.1:9000;
            fastcgi_read_timeout 60s;
        }
    }
}
